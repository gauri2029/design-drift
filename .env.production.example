# Production environment for the Design Drift API.
#
# Not a file to deploy. Render (and most hosts) take these as dashboard
# environment variables; `render.yaml` already declares every one of them,
# so this exists to show what a correct production set looks like and why
# each value differs from local development.
#
# The real .env is gitignored. Nothing secret belongs in this file.

# --- App ---
# Anything other than "local" makes app/main.py refuse to boot on the
# committed JWT default. That refusal is the point: a secret in a public
# repo means anyone can forge a token for any account.
APP_ENV=production
LOG_LEVEL=INFO

# --- Auth ---
# openssl rand -hex 32
# On Render this is `generateValue: true`, so you never type it.
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- Database ---
# The managed instance's connection string, with the asyncpg driver.
# Render's own string starts `postgres://`; SQLAlchemy needs
# `postgresql+asyncpg://`. The blueprint's fromDatabase wiring handles
# this, but a hand-configured service must convert it.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/design_drift

# --- CORS ---
# The exact origin of the deployed frontend. One value, no trailing slash.
# A wildcard is not a loosening here but a breakage: app/main.py sets
# allow_credentials=True, and browsers reject "*" in that combination.
CORS_ORIGINS=https://design-drift.vercel.app

# --- Writable paths ---
# All three must sit on the mounted persistent disk. On the container
# filesystem they are wiped by every deploy, which would make every stored
# run's screenshots 404 the moment you push a commit.
STORAGE_ROOT=/data/storage
WORKSPACE_ROOT=/data/workspaces
# No hand-placed local checkouts in production; projects read source from
# GitHub. Still set, because the containment check resolves against it.
SOURCE_ROOT=/data/sources

# --- AI provider ---
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Free tier, for a deployment you do not want to bill. Note the privacy
# tradeoff documented in the README: the free Gemini terms are why
# private-repository analysis is deferred.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Figma ---
FIGMA_ACCESS_TOKEN=
FIGMA_API_BASE_URL=https://api.figma.com/v1

# --- GitHub App (optional) ---
# Leave blank and the GitHub endpoints report "not configured" while
# everything else works unchanged.
#
# The key is a path to a file, never the key itself, so it cannot end up in
# a log line or a crash report. On Render: Environment -> Secret Files,
# then point this at /etc/secrets/<filename>.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY_PATH=
