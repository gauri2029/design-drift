# Copy this file to .env and fill in real values.
# Never commit the real .env file.

# --- App ---
APP_ENV=local
LOG_LEVEL=INFO

# --- Backend / FastAPI ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Comma-separated list of origins allowed to call the API (the Vite dev server by default)
CORS_ORIGINS=http://localhost:5173

# --- Database (PostgreSQL) ---
POSTGRES_USER=design_drift
POSTGRES_PASSWORD=design_drift
POSTGRES_DB=design_drift
POSTGRES_HOST=localhost
# Host-side port Docker Compose publishes postgres on (see infra/docker/docker-compose.yml).
# Defaults to 55432, not 5432, in case a native Postgres is already running locally.
POSTGRES_PORT=55432
POSTGRES_HOST_PORT=55432
# Full async SQLAlchemy URL, built from the parts above by default. Used when
# running the backend directly on the host (uv run uvicorn ...); the
# Dockerized backend overrides this to point at postgres:5432 internally.
DATABASE_URL=postgresql+asyncpg://design_drift:design_drift@localhost:55432/design_drift

# --- Frontend / Vite ---
# Base URL the frontend uses to reach the backend API.
VITE_API_BASE_URL=http://localhost:8000

# --- AI provider (added in a later phase, not required yet) ---
# ANTHROPIC_API_KEY=

# --- Figma ---
# Personal access token: https://www.figma.com/developers/api#access-tokens
FIGMA_ACCESS_TOKEN=
FIGMA_API_BASE_URL=https://api.figma.com/v1

# --- Storage (local filesystem, behind app/integrations/storage) ---
# Relative to backend/'s working directory by default (-> repo-root/storage).
STORAGE_ROOT=../storage
