# Copy this file to .env and fill in real values.
# Never commit the real .env file.

# --- App ---
APP_ENV=local
LOG_LEVEL=INFO

# --- Backend / FastAPI ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Comma-separated list of origins allowed to call the API (the Vite dev server by default)
CORS_ORIGINS=http://localhost:5173

# --- Database (PostgreSQL) ---
POSTGRES_USER=design_drift
POSTGRES_PASSWORD=design_drift
POSTGRES_DB=design_drift
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Full async SQLAlchemy URL, built from the parts above by default.
DATABASE_URL=postgresql+asyncpg://design_drift:design_drift@localhost:5432/design_drift

# --- Frontend / Vite ---
# Base URL the frontend uses to reach the backend API.
VITE_API_BASE_URL=http://localhost:8000

# --- AI provider (added in a later phase, not required yet) ---
# ANTHROPIC_API_KEY=

# --- Figma (added in a later phase, not required yet) ---
# FIGMA_ACCESS_TOKEN=
